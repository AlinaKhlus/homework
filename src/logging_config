import logging
import os
from pathlib import Path

# Гарантируем, что папка logs существует
Path("logs").mkdir(exist_ok=True)

def setup_logger(name: str, log_file: str, level=logging.DEBUG) -> logging.Logger:
    """
    Создает и настраивает логер для конкретного модуля.
    Файл лога перезаписывается при каждом запуске (mode='w').
    """
    # Создаем отдельный объект логера
    logger = logging.getLogger(name)
    logger.setLevel(level)
    logger.propagate = False  # Чтобы логи не дублировались в root logger

    # Если у логера уже есть обработчики (например, при повторном импорте), не добавляем новые
    if not logger.handlers:
        # Обработчик для записи в файл
        f_handler = logging.FileHandler(log_file, mode='w', encoding='utf-8')
        f_handler.setLevel(level)

        # Форматтер: время, название модуля, уровень, сообщение
        f_format = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
        f_handler.setFormatter(f_format)

        logger.addHandler(f_handler)

    return logger
